{
  "name": "Olist Insights (CVD-validated)",
  "dataColors": [
    "#2A78D6",
    "#EB6834",
    "#1BAF7A",
    "#EDA100",
    "#E87BA4",
    "#008300",
    "#6250D6",
    "#E34948"
  ],
  "background": "#FCFCFB",
  "secondaryBackground": "#F0EFEC",
  "foreground": "#0B0B0B",
  "foregroundNeutralSecondary": "#52514E",
  "foregroundNeutralTertiary": "#898781",
  "backgroundLight": "#F9F9F7",
  "backgroundNeutral": "#E1E0D9",
  "tableAccent": "#2A78D6",
  "good": "#0CA30C",
  "neutral": "#FAB219",
  "bad": "#D03B3B",
  "maximum": "#0D366B",
  "center": "#6DA7EC",
  "minimum": "#CDE2FB",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 13, "color": "#0B0B0B" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#0B0B0B" },
    "label": { "fontFace": "Segoe UI", "fontSize": 10, "color": "#52514E" },
    "callout": { "fontFace": "Segoe UI Semibold", "fontSize": 26, "color": "#0B0B0B" }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": true, "color": { "solid": { "color": "#E1E0D9" } }, "radius": 8 }],
        "dropShadow": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#0B0B0B" } }, "fontSize": 12 }],
        "valueAxis": [{ "gridlineColor": { "solid": { "color": "#E1E0D9" } }, "gridlineThickness": 1 }],
        "categoryAxis": [{ "gridlineShow": false }]
      }
    },
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#F9F9F7" } }, "transparency": 0 }]
      }
    }
  }
}
